# ============ DATABASE (Turso / libSQL) ============
NUXT_TURSO_URL=libsql://your-db.turso.io
NUXT_TURSO_AUTH_TOKEN=your-turso-token

# ============ SESSION ============
NUXT_SESSION_SECRET=change-me-32chars
NUXT_SESSION_MAX_AGE=86400

# ============ GOOGLE OAUTH2 (upload lampiran ke akun admin) ============
NUXT_GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
NUXT_GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
NUXT_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# NUXT_GOOGLE_REFRESH_TOKEN tidak dipakai lagi.
# Refresh token tersimpan otomatis di tabel google_connections
# setelah admin menghubungkan lewat /admin/integrations.

# ============ APP ============
NUXT_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=Aktivitas Harian
